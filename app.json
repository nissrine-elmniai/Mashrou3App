{
  "expo": {
    "name": "مهندس حامل لكتاب الله",
    "slug": "Mashrou3App",
    "scheme": "mashrou3app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nissrineelmniai.Mashrou3App",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nissrineelmniai.Mashrou3App",
      "supportsRtl": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mashrou3app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "169c3088-003d-4709-9727-dfc55f44d6ef"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e516fd4c-2f64-4062-a2f6-0af20da9fc64"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications"
    ],
    "owner": "oumeyma_elaammari"
  }
}
